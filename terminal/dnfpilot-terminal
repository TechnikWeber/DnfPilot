#!/usr/bin/env bash
# dnfpilot-terminal – the single-file variant of dnfpilot.
# Needs nothing but bash, kdialog and Konsole (KDE Plasma). The UI is German.
#
# Without an argument: kdialog menu. With an argument: runs that mode in the
# terminal (the menu starts itself again inside Konsole).
#
# Install:  install -m755 dnfpilot-terminal ~/.local/bin/
#           install -m644 dnfpilot-terminal.desktop ~/.local/share/applications/

TITLE="Fedora aktualisieren"
ICON="system-software-update"
SELF="$(readlink -f "$0")"

# ---------- Menü (grafisch) ----------
if [ -z "$1" ]; then
    MODE=$(kdialog --title "$TITLE" --icon "$ICON" --geometry 560x360 \
        --radiolist "Was soll gemacht werden?" \
        normal   "Normales Update: System + Flatpak-Apps (empfohlen)" on \
        flatpak  "Nur Flatpak-Apps aktualisieren" off \
        discover "Kaputtes Discover-Offline-Update abbrechen, dann updaten" off \
        clean    "DNF macht Fehler: Paketlisten neu laden, dann updaten" off \
        conflict "Paketkonflikte lösen (--allowerasing, kann Pakete entfernen!)" off \
        pkcache  "Discover-/PackageKit-Zwischenspeicher leeren" off \
        offline  "Offline-Update selbst gesteuert (beim Neustart installieren)" off \
        reboot   "Jetzt neu starten" off) \
        || exit 0

    if [ "$MODE" = conflict ]; then
        kdialog --title "$TITLE" --warningcontinuecancel \
"Achtung: Dieser Modus kann einzelne Pakete entfernen.

Lies im Terminal vor dem »y« genau die Liste der Pakete,
die entfernt werden sollen." || exit 0
    fi

    if [ "$MODE" = reboot ]; then
        kdialog --title "$TITLE" --warningcontinuecancel \
            "Den Computer jetzt neu starten? Offene Arbeit vorher speichern." \
            --continue-label "Jetzt neu starten" && systemctl reboot
        exit 0
    fi

    exec konsole -p tabtitle="$TITLE" -e "$SELF" "$MODE"
fi

# ---------- Ausführung (im Terminal) ----------
MODE="$1"
bold=$'\e[1m'; green=$'\e[32m'; red=$'\e[31m'; yellow=$'\e[33m'; reset=$'\e[0m'

step() { printf '\n%s==> %s%s\n' "$bold$green" "$*" "$reset"; }
info() { printf '%s%s%s\n' "$yellow" "$*" "$reset"; }

fail() {
    printf '\n%sFehler: %s%s\n' "$bold$red" "$*" "$reset"
    kdialog --title "$TITLE" --error "Es ist ein Fehler aufgetreten:
$*

Details stehen im Terminalfenster.
Tipp: Im Menü »DNF macht Fehler« oder »Paketkonflikte lösen« probieren." &
    read -rp $'\nEnter drücken zum Schließen …'
    exit 1
}

dnf_upgrade() {
    step "Systempakete aktualisieren (dnf upgrade --refresh $*)"
    info "Passwort eingeben – beim Tippen sieht man nichts, das ist normal."
    info "Bei »Is this ok [y/N]« mit  y  und Enter bestätigen."
    sudo dnf upgrade --refresh "$@" || fail "dnf upgrade ist fehlgeschlagen."
}

flatpak_update() {
    step "Flatpak-Apps aktualisieren"
    flatpak update -y || fail "flatpak update ist fehlgeschlagen."
}

dnf_clean() {
    step "Paketlisten neu laden (dnf clean all)"
    sudo dnf clean all || fail "dnf clean all ist fehlgeschlagen."
}

ask_reboot() {
    step "Prüfe, ob ein Neustart nötig ist …"
    if dnf needs-restarting -q >/dev/null 2>&1; then
        text="Fertig! Ein Neustart ist laut DNF nicht unbedingt nötig.

Trotzdem jetzt neu starten?"
    else
        text="Fertig! Es wurden Kernel, Plasma, systemd o. Ä. aktualisiert –
ein Neustart wird empfohlen.

Jetzt neu starten?"
    fi
    if kdialog --title "$TITLE" --icon "$ICON" --yesno "$text" \
        --yes-label "Jetzt neu starten" --no-label "Später"; then
        systemctl reboot
    fi
}

case "$MODE" in
    normal)
        dnf_upgrade
        flatpak_update
        ask_reboot
        ;;
    flatpak)
        flatpak_update
        kdialog --title "$TITLE" --icon "$ICON" --msgbox "Flatpak-Apps sind aktuell."
        ;;
    discover)
        step "Vorgemerktes Discover-Offline-Update abbrechen"
        sudo pkcon offline-cancel || info "(Kein Offline-Update vorgemerkt – ok.)"
        dnf_clean
        dnf_upgrade
        flatpak_update
        ask_reboot
        ;;
    clean)
        dnf_clean
        dnf_upgrade
        flatpak_update
        ask_reboot
        ;;
    conflict)
        dnf_clean
        info "ACHTUNG: Vor dem »y« die Liste der zu ENTFERNENDEN Pakete lesen!"
        dnf_upgrade --best --allowerasing
        ask_reboot
        ;;
    pkcache)
        step "PackageKit-Zwischenspeicher leeren (/var/cache/PackageKit)"
        sudo sh -c 'rm -rf /var/cache/PackageKit/*' || fail "Löschen fehlgeschlagen."
        kdialog --title "$TITLE" --icon "$ICON" --msgbox "Der Discover-/PackageKit-Zwischenspeicher wurde geleert."
        ;;
    offline)
        step "Updates herunterladen (dnf offline download --refresh)"
        info "Bei »Is this ok [y/N]« mit  y  und Enter bestätigen."
        sudo dnf offline download --refresh || fail "Download ist fehlgeschlagen."
        if kdialog --title "$TITLE" --icon "$ICON" --yesno \
"Alle Updates sind heruntergeladen.

Jetzt neu starten und beim Neustart installieren?" \
            --yes-label "Neu starten + installieren" --no-label "Später"; then
            sudo dnf offline reboot -y || fail "dnf offline reboot ist fehlgeschlagen."
        else
            info "Später einfach im Terminal:  sudo dnf offline reboot"
        fi
        ;;
    *)
        fail "Unbekannter Modus: $MODE"
        ;;
esac

printf '\n%sAlles erledigt.%s\n' "$bold$green" "$reset"
read -rp 'Enter drücken zum Schließen …'
